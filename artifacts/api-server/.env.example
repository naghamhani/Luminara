# API server -----------------------------------------------------------------
PORT=4000

# Postgres. Optional locally: without it the server still boots and serves the
# PPD risk model + chat, but persistence and research ingestion are disabled.
# DATABASE_URL=postgres://user:pass@localhost:5432/luminara

# Local LLM (Ollama) ----------------------------------------------------------
# Run `ollama pull llama3.1 && ollama serve`, then point these at it. In
# production, set OLLAMA_BASE_URL to the Ollama instance on your server.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=60000
